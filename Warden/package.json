{
  "name": "warden",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite web --host 0.0.0.0",
    "agent": "node --env-file-if-exists=agent/.env agent/server.mjs",
    "build": "tsc --noEmit -p web && vite build web",
    "preview": "vite preview web --host 0.0.0.0",
    "test": "node --test agent/*.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "vite": "6.4.3",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.7.3"
  }
}
